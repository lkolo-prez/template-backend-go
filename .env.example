# Example environment configuration. Copy to `.env` for local use (never commit `.env`).
# Every value below is the built-in default — the service boots with none of these set.
# See internal/config/config.go for the authoritative list.

# --- Networking ---
HOST=0.0.0.0
PORT=8080

# --- Service identity ---
SERVICE_NAME=template-backend-go
# one of: development | staging | production
ENVIRONMENT=development

# --- Logging ---
# one of: debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server timeouts ---
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
MAX_HEADER_BYTES=1048576

# --- OpenTelemetry ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# trace sample ratio, 0.0 - 1.0
OTEL_TRACES_SAMPLER_ARG=1.0
