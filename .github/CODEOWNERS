# Code ownership. Required reviewers are enforced by the GitHub Ruleset
# (see docs/BRANCH-PROTECTION.md). Teams must exist in the aircloud org.

# Default owners for everything in the repo.
*                           @aircloud/platform-engineering

# Security-sensitive areas need the security team too.
/.github/workflows/         @aircloud/platform-engineering @aircloud/security
/Dockerfile                 @aircloud/platform-engineering @aircloud/security
/.gitleaks.toml             @aircloud/platform-engineering @aircloud/security
/.golangci.yml              @aircloud/platform-engineering @aircloud/security
SECURITY.md                 @aircloud/security
/.well-known/               @aircloud/security

# Service entrypoint and config wiring need a platform lead review.
/cmd/                        @aircloud/platform-engineering @aircloud/platform-leads
/internal/config/           @aircloud/platform-engineering @aircloud/platform-leads
